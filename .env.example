# Neon Postgres (Vercel → Storage → Neon lo completa solo)
DATABASE_URL=
# Vercel Blob para subir fotos desde el panel (Storage → Blob lo completa solo)
BLOB_READ_WRITE_TOKEN=
# Contraseña del panel /admin
ADMIN_PASSWORD=
# Opcional: firma de la sesión del admin
AUTH_SECRET=
# Opcional: dominio público (ej. https://fikaeldra.com.ar)
NEXT_PUBLIC_SITE_URL=
# Opcional: copia del pedido por correo con Resend
RESEND_API_KEY=
MAIL_FROM=
ORDER_EMAIL=
